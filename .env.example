# Cazt
CAZT_BIND=0.0.0.0
CAZT_PORT=8787

# LAN IP that TVs should use to reach the optional media proxy.
# Do not set this to localhost. Example: 192.168.1.20
# CAZT_PUBLIC_HOST=192.168.1.20

# Logging: error, warn, info, debug, trace. Format: pretty | json
CAZT_LOG=info
CAZT_LOG_FORMAT=pretty

# Discovery
CAZT_DISCOVERY_TIMEOUT_SECS=4
CAZT_DISCOVERY_INTERVAL_SECS=30
CAZT_REQUEST_TIMEOUT_SECS=20
CAZT_MEDIA_SESSION_TTL_SECS=14400

# Fallback when multicast/mDNS/SSDP cannot reach the container
# CAZT_KNOWN_CAST_HOSTS=192.168.1.50:8009,192.168.1.51
# CAZT_KNOWN_DLNA_LOCATIONS=http://192.168.1.70:9197/dmr.xml

# Optional permitted JSON catalog for the cinejoy provider.
# cinejoy.pk itself has no public playback API; Cazt will not scrape it.
# CINEJOY_CATALOG_URL=https://example.com/permitted-catalog.json

CAZT_ALLOW_DIRECT_URLS=true
